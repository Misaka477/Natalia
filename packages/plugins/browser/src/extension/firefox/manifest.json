{
  "manifest_version": 3,
  "name": "Natalia Browser Bridge",
  "version": "0.1.0",
  "description": "Local bridge that lets Natalia control the user's existing Firefox browser.",
  "browser_specific_settings": {
    "gecko": {
      "id": "natalia-browser-bridge@natalia.dev",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["tabs", "activeTab", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  }
}
